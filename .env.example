# CollectorManager API
APP_NAME=collector-manager-api
ENV=dev

# MongoDB Atlas
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/?appName=collector
MONGO_DB=collector_manager

# JWT — cambiar en producción
JWT_SECRET=change-me-32bytes-minimum-secret!!
JWT_ALG=HS256
ACCESS_TTL_MIN=60
REFRESH_TTL_DAYS=30

# Bootstrap admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_USERNAME=admin

# Catálogo seed
CATALOG_SEED_PATH=../data/minigt-catalog.json
